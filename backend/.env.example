# Copy this file to .env and fill in real values before running the server.
# Never commit the real .env file.

# --- Database (zero-cost local SQLite by default) ---
DATABASE_URL="file:./data/dev.db"

# --- Server ---
PORT=4000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# --- Auth secrets ---
# Generate real random values before deploying, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string

# --- Admin account (provisioned by `npm run db:seed`) ---
# Change these before your first seed run. Never hardcode them in source.
ADMIN_USERNAME="rmrrealty.official@gmail.com"
ADMIN_PASSWORD=BORNTOWIN@2026

# --- Email notifications (zero-cost, via SMTP + Nodemailer) ---
# Optional but recommended: when set, the site emails the company whenever
# a contact/project lead or broker registration is submitted, in addition
# to always saving it to the database. If left unset, the site keeps
# working exactly as before — forms still save to the database and show
# up in the admin panel, they just won't also send an email.
#
# Easiest zero-cost option: a free Gmail "App Password" (NOT your normal
# Gmail password):
#   1. Go to https://myaccount.google.com/security
#   2. Turn on 2-Step Verification (if not already on)
#   3. Go to "App passwords", create one for "Mail"
#   4. Paste the 16-character app password below as SMTP_PASS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=rmrrealty.official@gmail.com
SMTP_PASS=paste_the_16_character_gmail_app_password_here
SMTP_FROM=rmrrealty.official@gmail.com
# Where notification emails are sent — defaults to SMTP_USER if left unset.
NOTIFY_TO=rmrrealty.official@gmail.com
